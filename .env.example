# Database (MySQL 8)
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/igl_visa_help"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Form configuration JSON path (relative to backend/ or absolute)
FORM_DATA_PATH="./visa_100_countries_visit_visa_official_fields.json"

# OTP & SMS Gateway
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
# Supported: query (GET), form (POST x-www-form-urlencoded), json (POST JSON)
SMS_API_FORMAT="query"
SMS_AUTH_HEADER="false"
SMS_MESSAGE_TEMPLATE="Your IGL Visa Help verification code is {code}. Valid for 5 minutes. Do not share it with anyone."

# JWT Auth (minimum 32 random characters)
JWT_SECRET="replace-this-with-a-strong-random-secret-at-least-32-chars"

# Initial Admin Seed Account
ADMIN_EMAIL="admin@iglvisahelp.com"
ADMIN_PASSWORD="ChangeMeStrong123!"
ADMIN_NAME="IGL Visa Help Admin"

