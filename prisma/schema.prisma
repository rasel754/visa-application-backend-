generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  NEW
  CHECKED
  PROCESSING
  COMPLETED
  REJECTED
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IntakeLink {
  id          String       @id @default(cuid())
  token       String       @unique @db.VarChar(64)
  countryCode String?      @db.VarChar(16)
  category    String?      @db.VarChar(64)
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@index([createdAt])
}

model Submission {
  id                String               @id @default(cuid())
  reference         String               @unique @db.VarChar(32)
  countryCode       String               @db.VarChar(16)
  countryName       String               @db.VarChar(128)
  category          String               @db.VarChar(64)
  officialVisaName  String               @db.VarChar(512)
  applicantName     String               @db.VarChar(255)
  applicantPhone    String               @db.VarChar(64)
  applicantEmail    String?              @db.VarChar(255)
  answers           Json
  status            SubmissionStatus     @default(NEW)
  downloadTokenHash String               @unique @db.VarChar(128)
  intakeLinkId      String?
  intakeLink        IntakeLink?          @relation(fields: [intakeLinkId], references: [id], onDelete: SetNull)
  documents         SubmissionDocument[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([countryCode])
  @@index([category])
  @@index([createdAt])
  @@index([applicantName])
  @@index([applicantPhone])
}

model SubmissionDocument {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  documentKey  String     @db.VarChar(128)
  label        String     @db.VarChar(512)
  originalName String     @db.VarChar(255)
  storedName   String     @db.VarChar(255)
  mimeType     String     @db.VarChar(128)
  sizeBytes    Int
  createdAt    DateTime   @default(now())

  @@index([submissionId])
  @@index([documentKey])
}

